{
    "name": "foziluff/swagger-generator",
    "description": "Auto-generate OpenAPI/Swagger 3.0 specs from Laravel Routes & Request classes",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/console": "^11.0",
        "illuminate/routing": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Foziluff\\Swagger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foziluff\\Swagger\\SwaggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
